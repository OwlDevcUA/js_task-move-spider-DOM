    if (wall) {
        spider.style.left = e.clientX - wallRect.left - wallBorder - spiderSize / 2 + "px";
        spider.style.top = e.clientY - wallRect.top - wallBorder - spiderSize / 2 + "px";
    }
    var spiderHeight = parseInt(spider.style.top, 10);
    var spiderWidth = parseInt(spider.style.left, 10);
